# n8n Admin Credentials
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_password_here

# Arogya Sahayak Webhook Security Secret
AROGYA_WEBHOOK_SECRET=your_shared_webhook_secret_here

# Supabase Credentials (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://reoskksryeqgehisaaho.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Telegram Bot API (From @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=7123456789:AAH...

# Meta WhatsApp Cloud API (From developer.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token

# Resend API Key (From resend.com - 3000 free emails/month)
RESEND_API_KEY=re_...

# OpenWeatherMap API Key (From openweathermap.org - 1000 free calls/day)
OPENWEATHER_API_KEY=your_openweathermap_key_here
